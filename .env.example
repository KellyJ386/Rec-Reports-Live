# Copy to .env.local and fill in. Never commit real keys.
NEXT_PUBLIC_SUPABASE_URL=https://qulauwtshcfisoerhfgg.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Job workers, provisioning and the rate limiter. Never exposed to the browser.
# In production the server refuses to start without this, SESSION_SIGNING_SECRET and SITE_URL.
SUPABASE_SERVICE_ROLE_KEY=
# Server only. Protects the cron routes (/api/cron/*): without it every cron call is refused.
# Vercel Cron sends it as `Authorization: Bearer <value>`. At least 32 characters, random
# (for example: openssl rand -base64 48); a shorter value is refused like an unset one.
CRON_SECRET=
# Public origin of this app (no path, no trailing slash). Used for password reset links. Never
# taken from request headers. Production must be https.
SITE_URL=http://localhost:3000
# Server only. Signs the admin idle-timeout cookie and keys rate-limit hashes. At least 32
# characters, random (for example: openssl rand -base64 48). Never commit a value.
SESSION_SIGNING_SECRET=
# Server only. Optional. Email delivery through Resend (free tier is enough for the pilot).
# Without both, email notifications are skipped with the reason "email not configured".
# EMAIL_FROM looks like: Rec Reports <alerts@your-verified-domain.example>
RESEND_API_KEY=
EMAIL_FROM=
# Optional. Web push. Generate a pair with: npx web-push generate-vapid-keys
# The public key is also used by the browser to subscribe. Without both keys, push is skipped.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto:you@example.com or an https URL. Defaults to SITE_URL when that is https.
VAPID_SUBJECT=
